<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>BudgetExport</RootNamespace>
    <AssemblyName>BudgetExport</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Only the OutSystems SDK: no third-party packages, the XLSX is built with System.IO.Compression -->
    <PackageReference Include="OutSystems.ExternalLibraries.SDK" Version="1.*" />
  </ItemGroup>

</Project>
